# syntax=docker/dockerfile:1
#
# Hardened Wolfi toolchain image: Python 3.14.x, Go, Rust.
# Variant: non-root, NO shell, NO package manager (distroless-style).
#
# Same approach as ./Dockerfile, but busybox and make are left out, and the
# build fails if any dependency pulls a shell back in.

ARG BASE_IMAGE=cgr.dev/chainguard/wolfi-base:latest

FROM ${BASE_IMAGE} AS builder

ARG PYTHON_VERSION=3.14
ARG GO_PACKAGE=go
ARG RUST_PACKAGE=rust
ARG EXTRA_PACKAGES=""
ARG APK_CACHE_BUST=0

RUN set -eux; \
    echo "cache-bust: ${APK_CACHE_BUST}"; \
    mkdir -p /rootfs; \
    apk add --no-cache --no-scripts --initdb --root /rootfs \
        --keys-dir /etc/apk/keys \
        --repositories-file /etc/apk/repositories \
        wolfi-baselayout \
        ca-certificates-bundle \
        glibc \
        glibc-locale-posix \
        tzdata \
        "python-${PYTHON_VERSION}" \
        "python-${PYTHON_VERSION}-dev" \
        "py${PYTHON_VERSION}-pip" \
        "${GO_PACKAGE}" \
        "${RUST_PACKAGE}" \
        gcc \
        glibc-dev \
        binutils \
        pkgconf \
        ${EXTRA_PACKAGES}; \
    # Guard: no shell or package manager may sneak in through dependencies.
    for f in /bin/sh /bin/bash /bin/ash /bin/busybox /usr/bin/busybox /sbin/apk /usr/bin/apk; do \
        if [ -e "/rootfs$f" ] || [ -L "/rootfs$f" ]; then \
            echo "ERROR: $f present in rootfs; owner:"; \
            apk info --root /rootfs --who-owns "$f" || true; \
            exit 1; \
        fi; \
    done; \
    for l in python3 python; do \
        [ -e "/rootfs/usr/bin/$l" ] || ln -s "python${PYTHON_VERSION}" "/rootfs/usr/bin/$l"; \
    done; \
    chroot /rootfs /usr/bin/python3 --version | grep -Eq "^Python ${PYTHON_VERSION}\.[0-9]+$"; \
    grep -q '^nonroot:' /rootfs/etc/passwd || \
        echo 'nonroot:x:65532:65532:nonroot:/home/nonroot:/sbin/nologin' >> /rootfs/etc/passwd; \
    grep -q '^nonroot:' /rootfs/etc/group || \
        echo 'nonroot:x:65532:' >> /rootfs/etc/group; \
    mkdir -p /rootfs/home/nonroot /rootfs/tmp; \
    chown -R 65532:65532 /rootfs/home/nonroot; \
    chmod 0750 /rootfs/home/nonroot; \
    chmod 1777 /rootfs/tmp; \
    find /rootfs -xdev -type f -perm /6000 -exec chmod a-s {} +; \
    rm -rf /rootfs/var/cache/apk/* /rootfs/etc/apk/keys /rootfs/root/.cache

# Wolfi's gcc depends on openssf-compiler-options, which routes gcc/cc/g++/...
# through /usr/local/bin/gcc-wrapper to add the OpenSSF hardening spec. That
# wrapper is a /bin/sh script, so without a shell cgo and Rust linking break.
# Replace it with a compiled equivalent that keeps the same behaviour.
COPY <<'EOF' /tmp/gcc-wrapper.c
/* Same logic as Wolfi's /usr/local/bin/gcc-wrapper shell script: run
 * /usr/bin/<basename of argv[0]> with "-specs SPEC" prepended, where SPEC is
 * $GCC_SPEC_FILE, else /etc/gcc_spec_file if it exists, else openssf.spec.
 */
#include <limits.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

int main(int argc, char **argv) {
    const char *name = strrchr(argv[0], '/');
    name = name ? name + 1 : argv[0];

    const char *spec = getenv("GCC_SPEC_FILE");
    if (spec == NULL || *spec == '\0')
        spec = access("/etc/gcc_spec_file", F_OK) == 0 ? "/etc/gcc_spec_file" : "openssf.spec";

    char path[PATH_MAX];
    if (snprintf(path, sizeof path, "/usr/bin/%s", name) >= (int)sizeof path) {
        fprintf(stderr, "gcc-wrapper: name too long\n");
        return 127;
    }

    char **args = calloc((size_t)argc + 3, sizeof *args);
    if (args == NULL) {
        perror("gcc-wrapper");
        return 127;
    }
    args[0] = path;
    args[1] = "-specs";
    args[2] = (char *)spec;
    for (int i = 1; i < argc; i++)
        args[i + 2] = argv[i];

    execv(path, args);
    perror(path);
    return 127;
}
EOF

RUN set -eux; \
    w=/rootfs/usr/local/bin/gcc-wrapper; \
    if [ -f "$w" ] && [ "$(head -c2 "$w")" = '#!' ]; then \
        apk add --no-cache gcc glibc-dev; \
        gcc -O2 -Wall -Werror -o /tmp/gcc-wrapper /tmp/gcc-wrapper.c; \
        install -m 0755 /tmp/gcc-wrapper "$w"; \
    fi; \
    # Guard: every compiler entry point must be runnable without a shell.
    for f in /rootfs/usr/local/bin/*; do \
        t=$(readlink -f "$f"); \
        if [ -f "$t" ] && [ "$(head -c2 "$t")" = '#!' ]; then \
            echo "ERROR: $f -> $t is a script and needs an interpreter"; exit 1; \
        fi; \
    done; \
    rm -f /tmp/gcc-wrapper /tmp/gcc-wrapper.c

FROM scratch

COPY --from=builder /rootfs/ /

ENV PATH=/home/nonroot/.cargo/bin:/home/nonroot/go/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin \
    HOME=/home/nonroot \
    LANG=C.UTF-8 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    GOTOOLCHAIN=local \
    GOPATH=/home/nonroot/go \
    GOCACHE=/home/nonroot/.cache/go-build \
    GOFLAGS=-trimpath \
    CARGO_HOME=/home/nonroot/.cargo

USER 65532:65532
WORKDIR /home/nonroot

# No shell: invoke tools directly, e.g.
#   docker run --rm IMAGE go version
#   docker run --rm IMAGE cargo --version
CMD ["/usr/bin/python3"]
