# certproxy settings. Secrets (Cloudflare token, TOTP key) live in Vault, not here.

VAULT_ADDR=https://vault.netseclabs.com
# VAULT_NAMESPACE=
# VAULT_CACERT=/path/to/private-ca.pem   (mount it into the container)
KV_MOUNT=secret

# Let's Encrypt staging while testing; switch to "letsencrypt" for real certificates.
ACME_SERVER=letsencrypt_test
ACME_EMAIL=ops@netseclabs.com
ACME_DNS_PROVIDER=dns_cf

# Base URL for one-time enrollment links (first admin, invites). Defaults to
# https://PUBLIC_HOSTNAME:8443 when TLS_MODE=self.
# PUBLIC_URL=https://certproxy.netseclabs.com:8443
INVITE_TTL_MINUTES=30

# Web UI / API TLS: "self" issues and renews a certificate for PUBLIC_HOSTNAME
# through certproxy itself; "files" uses TLS_CERT_FILE / TLS_KEY_FILE.
TLS_MODE=self
PUBLIC_HOSTNAME=certproxy.netseclabs.com

RENEW_BEFORE_DAYS=30
RATE_LIMIT_PER_HOUR=20
SESSION_HOURS=8
LOG_FORMAT=json
